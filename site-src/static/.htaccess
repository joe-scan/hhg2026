# One address: https://happyherogames.com. Plain http and www both redirect there.
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://happyherogames.com%{REQUEST_URI} [L,R=301]

# The free games moved under /free/ on 20 Sep 2026. Both older addresses were out in the world
# for a while, so both still work.
RewriteRule ^(es|de|fr|it|ga)/halloween/?$ /$1/free/halloween/ [L,R=301]
RewriteRule ^halloween/?$ /free/halloween/ [L,R=301]
RewriteRule ^(es|de|fr|it|ga)/themes/(.*)$ /$1/free/$2 [L,R=301]
RewriteRule ^themes/(.*)$ /free/$1 [L,R=301]

# The name-in-lights page was retired on 20 Sep 2026. Its address goes to the free games.
RewriteRule ^(es|de|fr|it|ga)/name/?$ /$1/free/ [L,R=301]
RewriteRule ^name/?$ /free/ [L,R=301]

# A missing page anywhere, at any depth, gets the same file. It links back with absolute paths.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Browsers remember to use https for a year. No includeSubDomains, so a subdomain can still be added without a cert.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Pages, scripts and pictures are checked on every visit, so a deploy shows up straight away.
  # They still come back as a 304 when nothing changed, so this costs a request, not a download.
  # Without it the mark changed on 20 Sep 2026 and browsers kept showing the old one for a week.
  <FilesMatch "\.(html|js|css|svg|png|gif|webp|ico)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
