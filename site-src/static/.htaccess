# One address: https://happyherogames.com. Plain http and www both redirect there.
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://happyherogames.com%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  # Browsers remember to use https for a year. No includeSubDomains, so a subdomain can still be added without a cert.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Pages and scripts are checked on every visit, so a deploy shows up straight away.
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
